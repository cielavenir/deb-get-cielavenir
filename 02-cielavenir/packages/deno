DEFVER=1
ARCHS_SUPPORTED="amd64 arm64"
get_github_releases "dariogriffo/deno-debian" "latest"
if [ "${ACTION}" != "prettylist" ]; then
    URL=$(grep -v denort "${CACHE_FILE}" | grep -m 1 "browser_download_url.*${HOST_ARCH}\.deb\"" | cut -d '"' -f 4)
    VERSION_PUBLISHED=$(cut -d '/' -f 8 <<< "${URL/\%2B/-}")~griffo
fi
PRETTY_NAME="deno"
WEBSITE="https://deb.griffo.io/install-latest-deno-in-debian.html"
SUMMARY="deno javascript runtime"
